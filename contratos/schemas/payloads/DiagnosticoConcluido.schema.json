{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oficina.local/contratos/schemas/payloads/DiagnosticoConcluido.schema.json",
  "title": "DiagnosticoConcluido",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "mecanicoId",
    "diagnostico",
    "itens"
  ],
  "properties": {
    "mecanicoId": {
      "$ref": "https://oficina.local/contratos/schemas/envelope.schema.json#/$defs/uuid"
    },
    "diagnostico": {
      "$ref": "https://oficina.local/contratos/schemas/envelope.schema.json#/$defs/texto"
    },
    "itens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "tipo",
          "referenciaId",
          "quantidade"
        ],
        "properties": {
          "tipo": {
            "$ref": "https://oficina.local/contratos/schemas/envelope.schema.json#/$defs/tipoItem"
          },
          "referenciaId": {
            "$ref": "https://oficina.local/contratos/schemas/envelope.schema.json#/$defs/uuid"
          },
          "quantidade": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
