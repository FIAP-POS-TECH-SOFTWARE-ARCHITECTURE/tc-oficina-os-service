{
	"name": "oficina-api",
	"version": "1.0.0",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/src/main.js",
		"format": "prettier --write .",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
		"db:seed": "ts-node -P tsconfig.seed.json prisma/seed.ts",
		"sonar:up": "docker compose -f dev/docker-compose.yml up -d sonarqube",
		"sonar:down": "docker compose -f dev/docker-compose.yml stop sonarqube",
		"sonar:scan": "node scripts/sonar-scan.cjs",
		"ministack:up": "docker compose -f dev/docker-compose.yml up -d ministack",
		"ministack:down": "docker compose -f dev/docker-compose.yml stop ministack",
		"test:integracao": "jest --config ./test/jest-integracao.json --runInBand",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json --runInBand"
	},
	"dependencies": {
		"@nestjs/common": "^11.0.1",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.0.1",
		"@nestjs/jwt": "^11.0.2",
		"@nestjs/platform-express": "^11.0.1",
		"@nestjs/swagger": "^11.4.2",
		"@prisma/client": "^6.0.0",
		"argon2": "^0.44.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"express-rate-limit": "^8.4.1",
		"helmet": "^8.1.0",
		"nestjs-pino": "^4.6.1",
		"newrelic": "^14.3.9",
		"nodemailer": "^9.0.3",
		"pino": "^10.3.1",
		"pino-http": "^11.0.0",
		"prisma": "^6.0.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"semantic-response": "^1.0.4",
		"ts-node": "^10.9.2",
		"typescript": "^5.7.3"
	},
	"devDependencies": {
		"@aws-sdk/client-dynamodb": "^3.1147.0",
		"@aws-sdk/client-sns": "^3.1147.0",
		"@aws-sdk/client-sqs": "^3.1147.0",
		"@aws-sdk/client-ssm": "^3.1147.0",
		"@eslint/eslintrc": "^3.2.0",
		"@eslint/js": "^9.18.0",
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.1",
		"@testcontainers/postgresql": "^12.0.4",
		"@types/express": "^5.0.0",
		"@types/jest": "^30.0.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.10.7",
		"@types/nodemailer": "^8.0.1",
		"@types/supertest": "^6.0.2",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-prettier": "^5.2.2",
		"globals": "^16.0.0",
		"jest": "^30.0.0",
		"jest-cucumber": "^4.5.0",
		"pino-pretty": "^13.1.3",
		"prettier": "^3.4.2",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"testcontainers": "^12.2.0",
		"ts-jest": "^29.2.5",
		"ts-loader": "^9.5.2",
		"tsconfig-paths": "^4.2.0",
		"typescript-eslint": "^8.20.0"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s",
			"!**/*.spec.ts"
		],
		"coveragePathIgnorePatterns": [
			"/node_modules/",
			"src/main.ts",
			".*\\.module\\.ts$",
			".*\\.dto\\.ts$",
			"src/common/enums/",
			"src/prisma/prisma.service.ts",
			"src/result/"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node",
		"coverageThreshold": {
			"global": {
				"statements": 80,
				"branches": 70,
				"functions": 80,
				"lines": 80
			},
			"src/modules/ordens-servico/application/**/*.ts": {
				"statements": 80,
				"branches": 70,
				"functions": 80,
				"lines": 80
			},
			"src/modules/insumos/application/**/*.ts": {
				"statements": 80,
				"branches": 80,
				"functions": 80,
				"lines": 80
			},
			"src/modules/auth/application/**/*.ts": {
				"statements": 80,
				"branches": 70,
				"functions": 80,
				"lines": 80
			}
		}
	}
}
